# Optional. Enables REAL online enquiry submission through Supabase.
# Use ONLY the public anon key here. Never put a service-role key in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: GitHub Pages project sites only, e.g. /myronix-site/
VITE_BASE=/
# Your real production URL, e.g. https://example.com (no trailing slash). Leave empty until the domain is known:
# canonical/Open Graph/sitemap tags are then omitted rather than faked.
VITE_SITE_URL=
